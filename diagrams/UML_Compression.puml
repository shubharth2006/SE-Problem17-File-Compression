@startuml
left to right direction

actor User

rectangle "File Compression Tool" {
    usecase "Select Input Files/Folders" as UC1
    usecase "View Selected Files" as UC2
    usecase "Specify Archive Name\n& Destination" as UC3
    usecase "Compress Files" as UC4
    usecase "Display Compression\nStatus" as UC5
    usecase "Display Success/Error" as UC6

    UC4 ..> UC1 : <<include>>
    UC4 ..> UC2 : <<include>>
    UC4 ..> UC3 : <<include>>
    UC4 ..> UC5 : <<include>>
    UC4 ..> UC6 : <<include>>
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

@enduml
