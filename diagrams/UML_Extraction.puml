@startuml
left to right direction

actor User

rectangle "File Compression Tool" {
    usecase "Select ZIP Archive" as UE1
    usecase "Select Extraction\nDestination" as UE2
    usecase "Extract Files" as UE3
    usecase "Preserve Directory\nStructure" as UE4
    usecase "Confirm Overwrite" as UE5
    usecase "Display Extraction\nStatus" as UE6
    usecase "Display Success/Error" as UE7

    UE3 ..> UE1 : <<include>>
    UE3 ..> UE2 : <<include>>
    UE3 ..> UE4 : <<include>>
    UE3 ..> UE6 : <<include>>
    UE3 ..> UE7 : <<include>>
    UE5 ..> UE3 : <<extend>>
}

User --> UE1
User --> UE2
User --> UE3
User --> UE5
User --> UE6
User --> UE7

@enduml
